# =====================================================================
# Variaveis de ambiente do back-end.
# Lidas pelo Spring atraves da linha spring.config.import do
# application.properties, que aponta para ./.env relativo a pasta de
# onde a aplicacao roda (backend).
# Este arquivo e um MODELO. Copie para .env, preencha, e nunca
# versione o .env - ele esta no .gitignore.
# =====================================================================

# Alias de conexao do Oracle, definido no tnsnames.ora que vem dentro da
# carteira. O sufixo _high e um dos tres servicos da Autonomous: prioriza
# paralelismo por consulta, adequado a carga e processamento pesado.
TNS_NAME=georural_high

# Dono das tabelas. E o schema que o Flyway versiona.
DB_USERNAME=GEORURAL

# Senha do usuario acima. Regras da Autonomous: 12 a 30 caracteres, com
# maiuscula, minuscula e numero, sem aspas, e nao pode conter o nome do
# proprio usuario.
DB_PASSWORD=

# Pasta da carteira do Oracle, a que contem cwallet.sso e tnsnames.ora.
# Use barra normal mesmo no Windows. Fica FORA do repositorio.
WALLET_DIR=C:/caminho/para/a/wallet

# Quem o back-end aceita como emissor do token. Tem que ser identico ao
# campo iss que o Keycloak escreve dentro do JWT, caractere por
# caractere, senao toda requisicao autenticada volta 401.
# Local: a porta definida em infra/.env. Na nuvem: o endereco publico.
KEYCLOAK_ISSUER_URI=http://localhost:8280/realms/georural
