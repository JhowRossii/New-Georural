*.zip
*.tar
*.tar.gz
*.7z
*.rar

# ---- IDE ----
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath

# ---- Sistema operacional ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs ----
*.log
logs/
