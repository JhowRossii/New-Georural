# =====================================================================
# Variaveis da infraestrutura local.
# Lidas automaticamente pelo Docker Compose, que procura este arquivo
# na mesma pasta do docker-compose.yml.
# =====================================================================

# Usuario administrador inicial do Keycloak.
# ATENCAO: so tem efeito na PRIMEIRA subida, quando o realm master e
# criado. Depois disso, mudar o valor aqui nao muda nada - seria
# preciso apagar o volume keycloak-dados.
KEYCLOAK_ADMIN_USER=admin

# Senha do administrador acima. Mesma regra: vale so na primeira subida.
KEYCLOAK_ADMIN_PASSWORD=

# Porta do Keycloak na SUA maquina. A porta de dentro do container
# continua 8080. Escolhemos 8280 porque a 8080 e do back-end e a 8180
# esta ocupada pelo Keycloak do projeto antigo.
KEYCLOAK_PORT=8280

# Endereco publico que o Keycloak declara ser o dele. E esta variavel
# que fixa o campo iss do token: sem ela o Keycloak monta o emissor a
# partir do endereco pelo qual o token foi pedido, e um cliente que
# chega por outro nome leva 401. Tem que casar exatamente com o
# KEYCLOAK_ISSUER_URI do backend/.env.
KEYCLOAK_HOSTNAME=http://localhost:8280
