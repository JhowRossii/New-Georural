# Destino do proxy de desenvolvimento do Vite (nao e exposto ao navegador).
BACKEND_URL=http://localhost:8080

# Endereco do Keycloak. O navegador e redirecionado para ca de verdade, entao
# precisa ser o endereco real - nao pode passar por proxy, senao o emissor do
# token nao bate com o KC_HOSTNAME do servidor e toda chamada volta 401.
VITE_KEYCLOAK_URL=http://localhost:8280
VITE_KEYCLOAK_REALM=georural
VITE_KEYCLOAK_CLIENT_ID=georural-front

# Em producao, a origem publica do backend, sem /api no final.
# VITE_API_URL=https://backend.exemplo.com